<UserControl xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:SCADA.ViewModels"
x:Class="SCADA.Views.SettingsView"
x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.segmented">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="480" HorizontalAlignment="Left">

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
            <Grid ColumnDefinitions="200,Auto">
                <TextBlock Classes="body" Text="Тема оформления" VerticalAlignment="Center" />
                <ListBox Grid.Column="1" Classes="segmented"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding Theme}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="body"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
            <Grid ColumnDefinitions="200,Auto">
                <TextBlock Classes="body" Text="Звук аварий" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent=""
                           IsChecked="{Binding AlarmSoundEnabled}" />
            </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
            <Grid ColumnDefinitions="200,Auto">
                <TextBlock Classes="body" Text="Таймаут сессии, мин" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Width="80"
                            Text="{Binding SessionTimeoutMinutes}"
                            Background="{DynamicResource Bg2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            CornerRadius="3" />
            </Grid>
        </Border>

        <Border Padding="0,14">
            <Grid ColumnDefinitions="200,Auto">
                <TextBlock Classes="body" Text="Плотность таблиц" VerticalAlignment="Center" />
                <ListBox Grid.Column="1" Classes="segmented"
                        ItemsSource="{Binding DensityOptions}"
                        SelectedItem="{Binding TableDensity}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="body"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
