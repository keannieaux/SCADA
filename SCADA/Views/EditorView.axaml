<UserControl xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:SCADA.ViewModels"
xmlns:ic="using:FluentIcons.Avalonia"
x:Class="SCADA.Views.EditorView"
x:DataType="vm:EditorViewModel">

    <UserControl.Styles>
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.segmented">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource Bg0Brush}">

        <Border Grid.Row="0" Height="40" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="12,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <ic:FluentIcon Icon="Grid" IconVariant="Filled" FontSize="16"
                                    Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Classes="body" FontWeight="Bold" FontSize="14" Text="SCADA"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="menu-item" Content="Файл"/>
                    <Button Classes="menu-item" Content="Правка"/>
                    <Button Classes="menu-item" Content="Вид"/>
                    <Button Classes="menu-item" Content="Проект"/>
                    <Button Classes="menu-item" Content="Мнемосхема"/>
                    <Button Classes="menu-item" Content="Сервис"/>
                    <Button Classes="menu-item" Content="Справка"/>
                </StackPanel>

                <Border Grid.Column="3" Background="{DynamicResource Bg2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}"/>
                        <TextBlock Classes="body" FontSize="12" Foreground="{DynamicResource Text2Brush}" Text="Проект:"/>
                        <TextBlock Classes="body" FontSize="12" FontWeight="Bold" Text="Каки писи"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Bg2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="PP" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Classes="body" FontSize="12" VerticalAlignment="Center" Text="P.Pipirkin"/>
                    <TextBlock Classes="body" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Text="Инженегр"/>
                </StackPanel>

                <ListBox Grid.Column="5" Classes="segmented" VerticalAlignment="Center"
                        ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="body" FontSize="10.5" FontWeight="Bold"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <Border Grid.Row="1" Height="40" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Тулбар" VerticalAlignment="Center" Margin="12,0" Classes="body"/>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="260,*,300">
            <Border Grid.Column="0" Background="{DynamicResource Bg1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <TextBlock Text="Объекты / Проект" Margin="12" Classes="body"/>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Bg0Brush}">
                <TextBlock Text="Холст" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="body"/>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Bg1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <TextBlock Text="Свойства / Слои" Margin="12" Classes="body"/>
            </Border>
        </Grid>

        <Border Grid.Row="3" Height="26" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="Статус-бар" VerticalAlignment="Center" Margin="12,0" Classes="body"/>
        </Border>

    </Grid>

</UserControl>
