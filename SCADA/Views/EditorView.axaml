<UserControl xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:SCADA.ViewModels"
x:Class="SCADA.Views.EditorView"
x:DataType="vm:EditorViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource Bg0Brush}">

        <Border Grid.Row="0" Height="40" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Меню" VerticalAlignment="Center" Margin="12,0" Classes="body"/>
        </Border>

        <Border Grid.Row="1" Height="40" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Тулбар" VerticalAlignment="Center" Margin="12,0" Classes="body"/>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="260,*,300">
            <Border Grid.Column="0" Background="{DynamicResource Bg1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <TextBlock Text="Объекты / Проект" Margin="12" Classes="body"/>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Bg0Brush}">
                <TextBlock Text="Холст" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="body"/>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Bg1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <TextBlock Text="Свойства / Слои" Margin="12" Classes="body"/>
            </Border>
        </Grid>

        <Border Grid.Row="3" Height="26" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="Статус-бар" VerticalAlignment="Center" Margin="12,0" Classes="body"/>
        </Border>

    </Grid>

</UserControl>
