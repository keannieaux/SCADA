<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SCADA.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SCADA.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SCADA"
        Background="{DynamicResource Bg0Brush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <ContentControl Content="{Binding LoginViewModel}" IsVisible="{Binding !IsLoggedIn}"/>
        <ContentControl Content="{Binding EditorViewModel}" IsVisible="{Binding IsLoggedIn}"/>
    </Panel>

</Window>
